# Cloudflare Pages response headers for orangeway.app
#
# Content-Security-Policy ran Report-Only from 2026-07-24 so violations could be
# logged to GlitchTip (report-uri) without blocking anything, and the host
# allow-list confirmed complete. It is ENFORCING here as of 2026-08-17 on dev.
# report-uri is deliberately kept: an enforcing policy still reports, and those
# reports are how a real break is caught. frame-ancestors and report-uri can
# only be delivered as a header, never via <meta>.
#
# Flip criterion, restated so it can be met: zero violations naming a source we
# own or depend on. Violations with an EMPTY source are not attributable to any
# host and cannot be allow-listed, so "zero violations" of any kind was a bar
# nothing could clear. Prod stays Report-Only until dev has run 48 hours clean
# under enforcement and QA has passed vault unlock, Turnstile and the support
# widget.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://support.orangeway.app https://eu-assets.i.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://eu.i.posthog.com https://pulse.orangeway.app https://support.orangeway.app; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://pulse.orangeway.app https://support.orangeway.app wss://support.orangeway.app; frame-src https://challenges.cloudflare.com https://support.orangeway.app; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; report-uri https://pulse.orangeway.app/api/1/security/?sentry_key=557469b0d58a45a3b7626e1329b014ee
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Force HTTPS for two years incl. subdomains; 'preload' opts into the browser
  # preload list. Orange Way is HTTPS-only behind Cloudflare, so this is safe.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Deny powerful browser features the app never uses (defense in depth).
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
