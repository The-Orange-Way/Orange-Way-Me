# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist

# npm lockfile — the project uses Bun. package-lock.json would go stale
# every time deps change. `bun.lock` (text format, current Bun default) is the
# single source of truth. Legacy `bun.lockb` (binary) was removed 2026-05-16
# (stale ~11 days when deleted; current Bun emits bun.lock by default).
package-lock.json
bun.lockb
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Playwright authenticated storage state (real session cookies + the
# unlocked-vault localStorage marker). Never commit. The auth.setup.ts
# spec writes this file fresh per run from env vars.
tests/e2e/.auth/
tests/e2e/screenshots/
playwright-report/
test-results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files — never commit real secrets/URLs
.env
.env.local
.env.*.local
supabase/.temp/

# Playwright artifacts — screenshots, traces, reports are generated locally
# every run; they belong in the wiki / Outline export, not in git.
tests/e2e/screenshots/
test-results/
playwright-report/
.reserved-terms
