#
# Orange Way: sample environment file.
#
# Copy to `.env` (gitignored) and fill in the values for your local Supabase
# project. Production deployments should set these via your hosting
# provider's env panel and Cloudflare Workers `wrangler secret put`.
# Never commit real values.
#
# The three VITE_ values are embedded into the client bundle at build time,
# so only commit values that are intentionally public (the Supabase
# "publishable" / anon key is designed to be public, see Supabase docs).
#

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mirrored non-VITE versions for the SSR / Cloudflare Workers path
# (`src/integrations/supabase/client.server.ts` reads these).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: override Orange Rails base URL (the Supabase project that hosts
# OR's edge functions). If unset, falls back to OR's production URL in code.
# VITE_OR_BASE_URL=

#
# Server-side / Cloudflare Workers secrets: set via `wrangler secret put`,
# NOT here. Listed for discoverability only.
#
#   SUPABASE_SERVICE_ROLE_KEY  : secret key (sb_secret_*), Workers SSR only.
#
# Edge Function secrets: set in Supabase Dashboard > Edge Functions > Secrets,
# NOT here. Listed for discoverability only.
#
#   OR_PLATFORM_API_KEY        : Orange Rails platform API key (server-to-server).
#   OR_BASE_URL                : OR Supabase URL (https://<ref>.supabase.co).
#   OR_SUPABASE_URL            : ow-or-proxy outbound target. Must match one of the
#                                allowlisted values in supabase/functions/ow-or-proxy/index.ts
#                                (production, staging, or dev orangerails.com).
#                                Defaults to https://api.orangerails.com when unset.
#   RESEND_API_KEY             : Resend API key for invite emails.
#   ADMIN_EMAIL_FROM           : From-address for admin/invite emails.
#   ALLOWED_ORIGINS            : comma-separated allow-list for Edge Function CORS.
#   INVITE_REDIRECT_URL        : magic-link landing URL for household invites.
#
# CI / deploy-time configuration: set as GitHub Actions repo vars / secrets,
# NOT here. Listed for discoverability only.
#
#   vars.VITE_SENTRY_DSN       : public DSN baked into the build for the Sentry
#                                / GlitchTip client. Unset = error telemetry no-op.
#   vars.SENTRY_URL            : base URL of the Sentry-protocol instance
#                                (e.g. self-hosted GlitchTip). Default in deploy.yml.
#   vars.SENTRY_ORG            : Sentry/GlitchTip org slug. Default in deploy.yml.
#   vars.SENTRY_PROJECT        : Sentry/GlitchTip project slug. Default in deploy.yml.
#   secrets.GLITCHTIP_API_TOKEN : auth token for source-map upload. Source-map
#                                upload step is skipped when unset.
#
